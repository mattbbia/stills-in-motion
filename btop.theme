# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0a0703"

# Main text color
theme[main_fg]="#DBD0BC"

# Title color for boxes
theme[title]="#DBD0BC"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7e8468"

# Background color of selected item in processes box. #DBD0BC maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #23201c gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#23201c"

# Foreground color of selected item in processes box. Use #DBD0BC so
# the row text stays readable on the lighter_bg highlight; the previous
# #7e8468 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#DBD0BC"

# Color of inactive/disabled text
theme[inactive_fg]="#605e58"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #e0d7c6 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #DBD0BC directly.
theme[graph_text]="#DBD0BC"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #DBD0BC collapsed to the main fg.
theme[meter_bg]="#23201c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #dfddb2 for a distinct accent instead of #e0d7c6 which capped to white.
theme[proc_misc]="#dfddb2"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c0a78c"
theme[mem_box]="#cbc3a3"
theme[net_box]="#a2947d"
theme[proc_box]="#7e8468"

# Box divider line and small boxes line color
theme[div_line]="#605e58"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#cbc3a3"
theme[temp_mid]="#fef2cb"
theme[temp_end]="#a2947d"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#dfddb2"
theme[cpu_mid]="#7e8468"
theme[cpu_end]="#c0a78c"

# Mem/Disk free meter
theme[free_start]="#c0a78c"
theme[free_mid]="#7e8468"
theme[free_end]="#dfddb2"

# Mem/Disk cached meter
theme[cached_start]="#7e8468"
theme[cached_mid]="#dfddb2"
theme[cached_end]="#c0a78c"

# Mem/Disk available meter
theme[available_start]="#fef2cb"
theme[available_mid]="#a2947d"
theme[available_end]="#a2947d"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#cbc3a3"
theme[used_mid]="#dfddb2"
theme[used_end]="#7e8468"

# Download graph colors
theme[download_start]="#fef2cb"
theme[download_mid]="#a2947d"
theme[download_end]="#a2947d"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#cbc3a3"
theme[upload_mid]="#dfddb2"
theme[upload_end]="#7e8468"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#dfddb2"
theme[process_mid]="#7e8468"
theme[process_end]="#c0a78c"
